set_driving_cell -lib_cell BUFX2M -library scmetro_tsmc_cl013g_rvt_ff_1p32v_m40c -fall -max -pin Y -from_pin A [get_ports {test_mode}]
set_load -pin_load -max  0.1  [get_ports {SO}]
set_load -pin_load -min  0.1  [get_ports {SO}]
set_case_analysis 0 [get_ports {SE}]
set_case_analysis 0 [get_ports {test_mode}]
set_input_delay -add_delay 200 -clock [get_clocks {DFT_CLK}] [get_ports {SE}]
set_input_delay -add_delay 54.26 -clock [get_clocks {RX_CLK}] [get_ports {RX_IN}]
set_input_delay -add_delay 200 -clock [get_clocks {DFT_CLK}] [get_ports {test_mode}]
set_input_delay -add_delay 200 -clock [get_clocks {DFT_CLK}] [get_ports {SI}]
set_output_delay -add_delay 54.26 -clock [get_clocks {RX_CLK}] [get_ports {STP_ERR}]
set_output_delay -add_delay 1736.32 -clock [get_clocks {TX_CLK}] [get_ports {TX_OUT}]
